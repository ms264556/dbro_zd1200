+/* Check a password against the file-based user/password store configured
+ * through -A file:<username_file>:<passwd_file> (Ruckus ZD1200).
+ *
+ * The username file and password file are parallel lists, one entry per line:
+ * the N-th line of the username file is the requested username and the N-th
+ * line of the password file is its corresponding password (compared in
+ * constant time).  Returns DROPBEAR_SUCCESS on a match, DROPBEAR_FAILURE
+ * otherwise. */
+static int check_file_password(const char *username, const char *password) {
+	FILE *uf = NULL;
+	FILE *pf = NULL;
+	int result = DROPBEAR_FAILURE;
+	buffer *ubuf = NULL;
+	buffer *pbuf = NULL;
+
+	if (svr_opts.auth_username_file == NULL || svr_opts.auth_passwd_file == NULL) {
+		return DROPBEAR_FAILURE;
+	}
+
+	uf = fopen(svr_opts.auth_username_file, "r");
+	if (uf == NULL) {
+		dropbear_log(LOG_WARNING, "Cannot open auth username file '%s'",
+				svr_opts.auth_username_file);
+		return DROPBEAR_FAILURE;
+	}
+	pf = fopen(svr_opts.auth_passwd_file, "r");
+	if (pf == NULL) {
+		dropbear_log(LOG_WARNING, "Cannot open auth password file '%s'",
+				svr_opts.auth_passwd_file);
+		fclose(uf);
+		return DROPBEAR_FAILURE;
+	}
+
+	ubuf = buf_new(DROPBEAR_MAX_LINE_LENGTH + 1);
+	pbuf = buf_new(DROPBEAR_MAX_LINE_LENGTH + 1);
+
+	while (buf_getline(ubuf, uf) == DROPBEAR_SUCCESS) {
+		/* null-terminate the line for the comparisons below */
+		ubuf->data[ubuf->len] = '\0';
+		if (buf_getline(pbuf, pf) == DROPBEAR_FAILURE) {
+			/* password file ran out of entries */
+			break;
+		}
+		pbuf->data[pbuf->len] = '\0';
+		if (strcmp((const char*)ubuf->data, username) == 0) {
+			if (constant_time_strcmp((const char*)pbuf->data, password) == 0) {
+				result = DROPBEAR_SUCCESS;
+			}
+			break;
+		}
+	}
+
+	buf_free(ubuf);
+	buf_free(pbuf);
+	fclose(uf);
+	fclose(pf);
+	return result;
+}
