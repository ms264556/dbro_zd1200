# Copy to .env and set values for your host. Do not commit .env.
# Guest management IP (used for the printed URL; the guest leases from DHCP and
# readiness is console-based, so the exact value only affects the printed URL).
ZD_GUEST_IP=192.168.50.10
# Host path to the signing-cert payload for the license patch (the license
# bypass). Must contain signing_cert.pem digital_sig_sha256.bin
# digital_sig_sha384.bin all_checksums.txt.  prepare-vendor-image.sh extracts
# these from the ZD firmware archive into ./image/signing-cert, so the default
# needs no action; set ZD_SIGN_CERT_HOST only to use a different cert.
ZD_SIGN_CERT_HOST=./image/signing-cert
# Container identity the guest's board-data MAC/serial is derived from
# (guest MAC1 = this).  Left empty, build-container.sh generates a unique,
# locally-administered MAC on first run and writes it here.  Change it (and
# reset the state volume) for a new appliance identity.
ZD_CONTAINER_MAC=
# Optional seven-character source revision appended to the ZoneDirector version
# on the admin console ("virtual <rev>").  Left empty, build-container.sh derives
# it from the checked-out Git revision; set it to pin a value (or to 0000000).
ZD_VIRTUAL_BUILD_ID=
# Optional: public key for a public-key-only root SSH listener on TCP 2222.
# Accepts an inline key or a path to a .pub file.  Set it (or pass
# --root-ssh-key to build-container.sh) to build the static dropbear
# replacement and install the listener; leave empty for the stock SSH only.
# ZD_ROOT_SSH_PUBLIC_KEY=~/.ssh/id_ed25519.pub
ZD_CONTAINER_NAME=zd1200
ZD_STATE_VOLUME=zd1200-state
