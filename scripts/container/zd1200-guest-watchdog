#!/usr/bin/env bash
#
# scripts/container/zd1200-guest-watchdog — recover a ZD1200 guest that has
# stopped answering.
#
# The appliance can wedge inside QEMU: QEMU keeps running (so Proxmox reports
# the VM as up) while the guest kernel stops answering, its NIC goes silent and
# every LAN address for it goes dark.  Nothing else in the container notices, so
# without this it stays dark until a human hard-resets it.  This watchdog probes the guest on
# a timer and, after a run of consecutive failures, asks QEMU to reboot it.
#
# Safety, so it cannot turn a slow boot into a reboot loop:
#   * it first waits until the guest HAS answered once (a booting guest is never
#     counted as failed);
#   * it only counts failures, so one flaky probe does nothing;
#   * after a reboot it waits out a long cooldown, and it stops counting until
#     the guest is healthy again;
#   * ZD_GUEST_WATCHDOG=0 disables the whole thing.
#
# Every action is logged twice, deliberately and exactly once each way: to this
# process's own stdout (the journal under the LXC flow's zd1200-watchdog.service,
# the container log under the Docker flow) and to $LOG_FILE, the flow's console
# log.  The console log is the correlated boot record -- the entrypoint writes
# board data and the whole launcher transcript into it as well -- so an operator
# reading it sees "the guest stopped answering" next to the last thing the guest
# printed, which is the point.  The rule the caller must keep: exactly ONE writer
# per destination.  A caller that also redirects this process's stdout into
# $LOG_FILE lands every line in the guest's record twice.
set -u

STATE_DIR="${STATE_DIR:-/var/lib/zd1200}"
RUN_DIR="${ZD_WATCHDOG_RUN_DIR:-/run}"
STATE_FILE="$RUN_DIR/zd1200-watchdog.state"
LOG_FILE="${ZD_WATCHDOG_LOG:-/tmp/zd1200-console.log}"
INTERVAL="${ZD_GUEST_WATCHDOG_INTERVAL:-60}"
FAILURES="${ZD_GUEST_WATCHDOG_FAILURES:-5}"
COOLDOWN="${ZD_GUEST_WATCHDOG_COOLDOWN:-900}"
# macvtap only: how long the guest's transmit counter may stay flat before the guest
# counts as silent at layer 2.
SILENT="${ZD_GUEST_WATCHDOG_SILENT:-600}"
HEALTHCHECK="${ZD_HEALTHCHECK_HELPER:-/usr/local/sbin/zd1200-guest-healthcheck}"
CONTROL_SOCK="${ZD_CONTROL_SOCK:-/tmp/zd1200-control.sock}"
PID_FILE="${ZD_QEMU_PID_FILE:-$STATE_DIR/qemu.pid}"
# How long a reboot request is given to take effect before the emulator is reset.
SOFT_WAIT="${ZD_GUEST_WATCHDOG_SOFT_WAIT:-90}"
PROC="${ZD_WATCHDOG_PROC:-/proc}"
# How to tell a silent guest from a merely unreachable one.  The guest's own L2
# activity is the evidence: a wedged guest has stopped transmitting.  Where that
# shows depends on the flow:
#
#   bridge   the Proxmox LXC flow puts the guest on its own bridge (br-zd).  The
#            guest's MAC is in that bridge's FDB while it keeps transmitting, and
#            ages out once it stops.
#   macvtap  the Docker flow gives the guest a macvtap on the host's uplink.  The
#            evidence is that macvtap's transmit counter, sampled on every pass so
#            the time it last moved is always known: a guest that has sent nothing
#            for ZD_GUEST_WATCHDOG_SILENT seconds (default 600) is silent, one that
#            sent anything within that time is alive, on whatever VLAN it sent it.
#            The limit is longer than the failure window on purpose: an idle
#            appliance can go quiet for several minutes (a static address, no
#            clients), and the guest's own hardware watchdog already resets a
#            kernel that hangs within a minute.  The host's neighbour table cannot
#            be used: it only holds untagged neighbours, so a guest whose own
#            address is on a management VLAN never appears in it and a healthy
#            appliance would be rebooted.
#   none     a launch mode with no guest NIC on the LAN to watch (user-mode
#            networking, a test tap).  There is no layer-2 evidence to read, so a
#            guest that stops answering is rebooted without it.
#
# Whatever the kind, a guest that restarts itself (the CLI's restart after a VLAN
# change, a firmware upgrade, a reboot from the UI) is silent from shutdown until
# its NIC comes back, and the emulator is relaunched meanwhile.  A new emulator pid
# since the failures began means "booting", not "wedged".
#
# ZD_WATCHDOG_GUEST_LINK names the bridge or the macvtap.  Getting this wrong is
# not cosmetic: with a link that does not exist the check fails closed and the
# watchdog would never recover anything, which is the failure mode this whole
# helper exists to avoid -- so an unusable link is reported rather than assumed.
BRIDGE="${ZD_BRIDGE_IF:-br-zd}"
GUEST_LINK="${ZD_WATCHDOG_GUEST_LINK:-}"
case "${ZD_WATCHDOG_LINK_KIND:-bridge}" in
    bridge)  LINK_KIND=bridge ;;
    macvtap) LINK_KIND=macvtap ;;
    none)    LINK_KIND=none ;;
    *)       LINK_KIND=bridge ;;
esac
[ -n "$GUEST_LINK" ] || GUEST_LINK="$BRIDGE"
# The netdev directory is a knob so the decision logic can be exercised offline
# against a fixture, without needing the interfaces to exist on the test host.
SYSFS_NET="${ZD_WATCHDOG_SYSFS:-/sys/class/net}"

log() {
    printf 'zd1200-watchdog: %s\n' "$*"
    # The console-log copy.  $LOG_FILE is the same file the entrypoint appends
    # the launcher transcript to, so this is the correlation with the guest's own
    # output -- and it is written HERE, once, which is why the caller must not
    # also redirect this process's stdout into it.
    if [ -w "$LOG_FILE" ]; then
        printf 'zd1200-watchdog: %s\n' "$*" >>"$LOG_FILE" 2>/dev/null || true
    fi
}

[ "${ZD_GUEST_WATCHDOG:-1}" = "0" ] && { log "disabled (ZD_GUEST_WATCHDOG=0)"; exit 0; }

# --- run state: warmup | running | cooldown ---------------------------------
phase="warmup"
fails=0
cooldown_until=0
# The emulator's pid when the current run of failures began.
pid_ref=""
# macvtap only: the guest's transmit counter at the last pass, and when it last moved.
tx_last=""
tx_moved_at=""
if [ -r "$STATE_FILE" ]; then
    # shellcheck disable=SC1090
    . "$STATE_FILE" 2>/dev/null || true
fi

save_state() {
    {
        printf 'phase=%s\n' "$phase"
        printf 'fails=%s\n' "$fails"
        printf 'cooldown_until=%s\n' "$cooldown_until"
        printf 'pid_ref=%s\n' "$pid_ref"
        printf 'tx_last=%s\n' "$tx_last"
        printf 'tx_moved_at=%s\n' "$tx_moved_at"
    } >"$STATE_FILE" 2>/dev/null || true
}

emulator_pid() { # the live emulator's pid, or nothing
    local pid
    pid="$(head -n1 "$PID_FILE" 2>/dev/null | tr -d ' \r\n')"
    case "$pid" in ""|*[!0-9]*) return 1 ;; esac
    [ -d "$PROC/$pid" ] || return 1
    printf '%s' "$pid"
}

# Recover the guest.  First the orderly way: "reboot" on ttyS1, which the guest's
# own hook acts on and which flushes /writable.  A guest that has stopped running
# userspace cannot act on it, so if the emulator is still the same process after
# SOFT_WAIT seconds it is reset from outside: SIGUSR1 to qemu-once.py (the
# emulator's parent), which issues QMP system_reset and relaunches.
reboot_guest() {
    local before now waited=0 parent
    before="$(emulator_pid || true)"
    if [ -S "$CONTROL_SOCK" ]; then
        log "requesting a guest reboot over the control channel"
        python3 - "$CONTROL_SOCK" <<'PY' 2>/dev/null || true
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(5)
s.connect(sys.argv[1])
s.sendall(b"reboot\n")
s.close()
PY
    else
        log "control channel $CONTROL_SOCK is missing; cannot request a guest reboot"
    fi
    if [ -z "$before" ]; then
        log "no live emulator pid in $PID_FILE; cannot reset the emulator"
        return 1
    fi
    while [ "$waited" -lt "$SOFT_WAIT" ]; do
        sleep 5; waited=$(( waited + 5 ))
        now="$(emulator_pid || true)"
        if [ "$now" != "$before" ]; then
            log "the guest rebooted on request"
            return 0
        fi
    done
    parent="$(awk '{print $4}' "$PROC/$before/stat" 2>/dev/null || true)"
    case "$parent" in ""|*[!0-9]*|0|1)
        log "the guest ignored the reboot request and the emulator's parent cannot be identified; cannot reset it"
        return 1 ;;
    esac
    log "the guest ignored the reboot request for ${SOFT_WAIT}s; resetting the emulator (pid $before)"
    kill -USR1 "$parent" 2>/dev/null || { log "could not signal pid $parent"; return 1; }
    return 0
}

# Whether the failure is the silent wedge this watchdog exists for.  A wedged
# guest has gone quiet at L2 as well: QEMU keeps running but the guest kernel
# stops answering and its NIC stops transmitting.  A guest that is merely
# unreachable -- its address moved while the control channel was unavailable, or
# its web service is down -- is still transmitting, and rebooting it would reboot
# a healthy appliance.  Returns 0 only when a reboot is warranted, and says which
# case it found.
#
# The lookup itself is one of two shapes (see GUEST_LINK above); `guest_seen`
# hides the difference so the decision logic below is identical for both flows.
# Returns 0 when the guest is seen, 1 when it is not, 2 when that cannot be told.
guest_tx() { # frames the guest has sent on the macvtap, or nothing
    local n
    n="$(cat "$SYSFS_NET/$GUEST_LINK/statistics/tx_packets" 2>/dev/null)" || return 1
    case "$n" in ""|*[!0-9]*) return 1 ;; esac
    printf '%s' "$n"
}

# Called on every pass: remember when the counter last moved.  The first sample, and
# the first one after the counter could not be read, count as "moved just now", which
# errs towards not rebooting.
track_tx() {
    local now t
    [ "$LINK_KIND" = macvtap ] || return 0
    if ! now="$(guest_tx)"; then tx_last=""; return 0; fi
    t="$(date +%s)"
    if [ "$now" != "$tx_last" ]; then
        tx_last="$now"
        tx_moved_at="$t"
    fi
}

tx_age() { # seconds since the guest's transmit counter last moved
    echo $(( $(date +%s) - ${tx_moved_at:-$(date +%s)} ))
}

guest_seen() {
    local now
    case "$LINK_KIND" in
        none)
            return 2
            ;;
        macvtap)
            # A frame the guest sends is counted as transmitted by its macvtap, so
            # a counter that moved within the last $SILENT seconds means the guest
            # kernel is still running, on any VLAN.  No counter is "cannot tell",
            # not "silent".
            now="$(guest_tx)" || return 2
            [ -n "$tx_moved_at" ] || return 2
            [ "$(tx_age)" -lt "$SILENT" ]
            ;;
        *)
            # The tool is only needed for this lookup, so its absence is a
            # "cannot tell" answer rather than a "not seen" one.
            command -v bridge >/dev/null 2>&1 || return 2
            bridge fdb show br "$GUEST_LINK" 2>/dev/null | grep -qi "^${ZD_MAC1}[[:space:]]"
            ;;
    esac
}

wedge_suspected() {
    local now_pid
    now_pid="$(emulator_pid || true)"
    if [ -n "$pid_ref" ] && [ -n "$now_pid" ] && [ "$now_pid" != "$pid_ref" ]; then
        log "the emulator was restarted since the failures began (pid $pid_ref -> $now_pid): the guest is booting, not wedged; not rebooting"
        return 1
    fi
    if [ "$LINK_KIND" != none ] && [ ! -e "$SYSFS_NET/$GUEST_LINK" ]; then
        # Without the link the container's own LAN path is broken; a guest
        # reboot cannot repair that, and the healthcheck already reports it.
        log "${LINK_KIND} $GUEST_LINK is missing: the container-side LAN is down, not the guest; not rebooting"
        return 1
    fi
    if [ "$LINK_KIND" = bridge ] && [ -z "${ZD_MAC1:-}" ]; then
        # Cannot inspect L2.  A watchdog that silently stops recovering a wedged
        # guest is the worse outcome, so proceed and say so.
        log "cannot tell whether the guest is still on the LAN (no ZD_MAC1); rebooting anyway"
        return 0
    fi
    local seen_rc=0
    guest_seen || seen_rc=$?
    case "$seen_rc" in
        0)
            if [ "$LINK_KIND" = macvtap ]; then
                log "the guest last sent a frame on $GUEST_LINK $(tx_age)s ago (limit ${SILENT}s): it is on the LAN, not wedged; not rebooting"
            else
                log "the guest's MAC ($ZD_MAC1) is still present on $GUEST_LINK: it is on the LAN, not wedged; not rebooting"
            fi
            return 1
            ;;
        2)
            # The evidence is unavailable, so absence cannot be concluded.
            if [ "$LINK_KIND" = none ]; then
                log "no layer-2 evidence in this network mode; rebooting anyway"
            else
                log "cannot inspect $GUEST_LINK (no bridge tool or transmit counter); rebooting anyway"
            fi
            return 0
            ;;
        *)
            if [ "$LINK_KIND" = macvtap ]; then
                log "the guest has sent nothing on $GUEST_LINK for $(tx_age)s (limit ${SILENT}s): it is silent at L2 as well; rebooting"
            else
                log "the guest's MAC ($ZD_MAC1) is gone from $GUEST_LINK: it is silent at L2 as well; rebooting"
            fi
            return 0
            ;;
    esac
}

log "starting (interval ${INTERVAL}s, ${FAILURES} failures before recovery, warmup)"
while :; do
    track_tx
    if "$HEALTHCHECK" >/dev/null 2>&1; then
        if [ "$phase" != "running" ]; then
            log "guest is answering; watching"
        fi
        phase="running"
        fails=0
    else
        case "$phase" in
            warmup)
                # Never blame a guest that has not been up yet.
                :
                ;;
            cooldown)
                if [ "$(date +%s)" -ge "$cooldown_until" ]; then
                    log "cooldown over; resuming checks"
                    phase="running"
                    fails=0
                fi
                # No counting during cooldown: a reboot needs time to boot.
                ;;
            running)
                # The first failure of a run: remember which emulator was running, so a
                # relaunch before the decision reads as "booting".
                [ "$fails" -eq 0 ] && pid_ref="$(emulator_pid || true)"
                fails=$(( fails + 1 ))
                log "guest did not answer (failure $fails/$FAILURES)"
                if [ "$fails" -ge "$FAILURES" ]; then
                    log "guest has not answered for $(( FAILURES * INTERVAL ))s"
                    if wedge_suspected && reboot_guest; then
                        phase="cooldown"
                        cooldown_until=$(( $(date +%s) + COOLDOWN ))
                        log "cooldown for ${COOLDOWN}s"
                    else
                        # Not a wedge (the guest is still on the LAN), or there is
                        # no control channel to ask.  Wait instead of spamming,
                        # and let the next interval re-evaluate.
                        fails=0
                    fi
                fi
                ;;
        esac
    fi
    save_state
    sleep "$INTERVAL"
done
