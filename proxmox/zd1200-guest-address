#!/usr/bin/env bash
#
# proxmox/zd1200-guest-address — find the guest's current LAN address.
#
# The guest is an ordinary DHCP client: it takes whatever address the LAN's DHCP
# server gives it, and the container only needs to know it to print a URL or to
# probe it.  In the macvtap/Docker layout the container shares no L2 with the
# guest, so the only way to see the lease was to sniff the DHCP exchange
# (scripts/container/sniff-guest-dhcp.py).  Here the container's bridge is a port
# of the same LAN, so the guest is an ordinary neighbour: make it answer and read
# the neighbour table.
#
# The guest's identity is its board-data MAC1 (ZD_MAC1 in /etc/zd1200.conf), which
# is what it transmits, so the address is found by MAC rather than guessed.
#
# Prints the address on stdout and records it, or prints nothing.
# Exit 0 when found, 1 otherwise.
#
# Options:
#   --timeout SEC   budget for the search (default 8)
#   --bridge IFACE  bridge to probe through (default $ZD_BRIDGE_IF)
#   --mac MAC       guest MAC (default ZD_MAC1 from /etc/zd1200.conf)
set -u

STATE_DIR="${STATE_DIR:-/var/lib/zd1200}"
BRIDGE="${ZD_BRIDGE_IF:-br-zd}"
GUEST_MAC="${ZD_MAC1:-}"
OUT_FILE="${ZD_GUEST_IP_FILE:-$STATE_DIR/guest-ip}"
TIMEOUT="${ZD_ADDRESS_TIMEOUT:-8}"
NO_SWEEP="${ZD_ADDRESS_NO_SWEEP:-0}"

while [ $# -gt 0 ]; do
    case "$1" in
        --timeout) TIMEOUT="${2:?}"; shift 2 ;;
        --bridge)  BRIDGE="${2:?}"; shift 2 ;;
        --mac)     GUEST_MAC="${2:?}"; shift 2 ;;
        -h|--help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done

[ -e "/sys/class/net/$BRIDGE" ] || exit 1

if [ -z "$GUEST_MAC" ] && [ -r /etc/zd1200.conf ]; then
    GUEST_MAC="$(sed -n 's/^ZD_MAC1=//p' /etc/zd1200.conf | head -1)"
fi
GUEST_MAC="$(printf '%s' "$GUEST_MAC" | tr 'A-Z' 'a-z')"
[ -n "$GUEST_MAC" ] || exit 1

# Match the MAC as a whole field: "10.222.1.110 lladdr bc:24:11:22:bb:cc STALE"
# is the only shape `ip neigh` produces, so field 3 is the address and field 5
# the MAC.  (An awk comparison here silently mismatched; a field-anchored grep
# is exact and has no quoting pitfalls.)
lookup_neighbour() {
    ip -4 neigh show dev "$BRIDGE" 2>/dev/null \
        | grep -i -E "(^|[[:space:]])$GUEST_MAC([[:space:]]|$)" \
        | awk '{print $1; exit}'
}

emit() {
    [ -n "$1" ] || return 1
    [ -n "$OUT_FILE" ] && printf '%s\n' "$1" >"$OUT_FILE" 2>/dev/null
    printf '%s\n' "$1"
}

# Cheapest path: the guest is already in the neighbour table.
found="$(lookup_neighbour)"
[ -n "$found" ] && emit "$found" && exit 0

deadline=$(( $(date +%s) + TIMEOUT ))

# Directed ARP probes: exact, and they revive an entry that has aged out.  The
# recorded address and GUEST_IP are the likely candidates.
if command -v arping >/dev/null 2>&1; then
    candidates="${ZD_GUEST_IP:-} $(head -n1 "$OUT_FILE" 2>/dev/null || true)"
    for candidate in $candidates; do
        case "$candidate" in *[!0-9.]*|"") continue ;; esac
        arping -q -c 2 -w 2 -I "$BRIDGE" "$candidate" >/dev/null 2>&1 || true
        found="$(lookup_neighbour)"
        [ -n "$found" ] && emit "$found" && exit 0
    done
fi

# Otherwise sweep the IPv4 subnet this bridge is on: the guest took its address
# from the LAN's pool, so it is on-link.  The prefix comes from the interface
# rather than being assumed, and a network wider than a /24 is swept only around
# our own address (a /16 holds 65k hosts, which is not worth probing).
if [ "$NO_SWEEP" != "1" ]; then
    own="$(ip -4 -o addr show dev "$BRIDGE" 2>/dev/null | awk '{print $4; exit}')"
    if [ -n "$own" ]; then
        addr="${own%%/*}"
        prefix="${own##*/}"
        case "$prefix" in
            ''|*[!0-9]*) prefix=24 ;;
        esac
        IFS=. read -r o1 o2 o3 _ <<<"$addr"
        if [ "$prefix" -ge 24 ]; then
            base="$o1.$o2.$o3"
        else
            # Wider subnet: stay within the /24 that contains us.
            base="$o1.$o2.$o3"
        fi
        for h in $(seq 1 254); do
            ping -c1 -W1 "$base.$h" >/dev/null 2>&1 &
        done
        wait
    fi
fi

for _ in $(seq 1 5); do
    found="$(lookup_neighbour)"
    [ -n "$found" ] && emit "$found" && exit 0
    [ "$(date +%s)" -ge "$deadline" ] && break
    sleep 1
done
exit 1
