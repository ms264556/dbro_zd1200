# Copy to .env and set values for your host. Do not commit .env.
ZD_IMAGE_DIR=./image
# Guest management IP (used by the readiness probe / healthcheck; the guest
# configures its own address - on a DHCP LAN set this to the guest's lease).
ZD_GUEST_IP=192.168.50.10
# Host interface whose LAN the container shares via macvlan (the parent).
ZD_MACVLAN_PARENT=eth0
# Only used when falling back to the host TAP path (NETWORK_MODE=tap).
ZD_TAP_IF=tap-zd
ZD_CONTAINER_NAME=zd1200
ZD_STATE_VOLUME=zd1200-state
