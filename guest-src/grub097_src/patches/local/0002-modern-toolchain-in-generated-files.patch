Description: Port the AUR configure.ac/Makefile.am changes into the tarball's
 pre-generated configure/Makefile.in, so GRUB builds with a current gcc/binutils
 without running autoconf/automake.
Author: this repository

configure: version string 0.97.1.39; the objcopy-absolute probe links with
${LDFLAGS} and takes only .text. stage1/stage2 Makefile.in: objcopy
-R .note* -R .comment*; STAGE1_CFLAGS/STAGE2_CFLAGS/GRUB_CFLAGS gain the
freestanding flags; stage1 LDFLAGS appends configure's LDFLAGS.

--- a/configure
+++ b/configure
@@ -269,8 +269,8 @@
 # Identity of this package.
 PACKAGE_NAME='GRUB'
 PACKAGE_TARNAME='grub'
-PACKAGE_VERSION='0.97'
-PACKAGE_STRING='GRUB 0.97'
+PACKAGE_VERSION='0.97.1.39'
+PACKAGE_STRING='GRUB 0.97.1.39'
 PACKAGE_BUGREPORT='bug-grub@gnu.org'
 
 ac_unique_file="stage2/stage2.c"
@@ -1699,7 +1699,7 @@
 
 # Define the identity of the package.
  PACKAGE='grub'
- VERSION='0.97'
+ VERSION='0.97.1.39'
 
 
 cat >>confdefs.h <<_ACEOF
@@ -3892,7 +3892,7 @@
 fi
 grub_cv_prog_objcopy_absolute=yes
 for link_addr in 2000 8000 7C00; do
-  if { ac_try='${CC-cc} ${CFLAGS} -nostdlib -Wl,-N -Wl,-Ttext -Wl,$link_addr conftest.o -o conftest.exec'
+  if { ac_try='${CC-cc} ${CFLAGS} ${LDFLAGS} -nostdlib -Wl,-N -Wl,-Ttext -Wl,$link_addr conftest.o -o conftest.exec'
   { (eval echo "$as_me:$LINENO: \"$ac_try\"") >&5
   (eval $ac_try) 2>&5
   ac_status=$?
@@ -3903,7 +3903,7 @@
 echo "$as_me: error: ${CC-cc} cannot link at address $link_addr" >&2;}
    { (exit 1); exit 1; }; }
   fi
-  if { ac_try='${OBJCOPY-objcopy} -O binary conftest.exec conftest'
+  if { ac_try='${OBJCOPY-objcopy} --only-section=.text -O binary conftest.exec conftest'
   { (eval echo "$as_me:$LINENO: \"$ac_try\"") >&5
   (eval $ac_try) 2>&5
   ac_status=$?
--- a/stage1/Makefile.in
+++ b/stage1/Makefile.in
@@ -110,7 +110,7 @@
 INSTALL_PROGRAM = @INSTALL_PROGRAM@
 INSTALL_SCRIPT = @INSTALL_SCRIPT@
 INSTALL_STRIP_PROGRAM = @INSTALL_STRIP_PROGRAM@
-LDFLAGS = -nostdlib -Wl,-N,-Ttext,7C00
+LDFLAGS = -nostdlib -Wl,-N,-Ttext,7C00 @LDFLAGS@
 LIBOBJS = @LIBOBJS@
 LIBS = @LIBS@
 LTLIBOBJS = @LTLIBOBJS@
@@ -140,7 +140,7 @@
 SERIAL_SUPPORT_TRUE = @SERIAL_SUPPORT_TRUE@
 SET_MAKE = @SET_MAKE@
 SHELL = @SHELL@
-STAGE1_CFLAGS = @STAGE1_CFLAGS@
+STAGE1_CFLAGS = @STAGE1_CFLAGS@ -fno-PIE
 STAGE2_CFLAGS = @STAGE2_CFLAGS@
 STRIP = @STRIP@
 VERSION = @VERSION@
@@ -427,7 +427,7 @@
 	uninstall-nodist_pkglibDATA
 
 .exec:
-	$(OBJCOPY) -O binary $< $@
+	$(OBJCOPY) -O binary -R .note* -R .comment* $< $@
 # Tell versions [3.59,3.63) of GNU make to not export all variables.
 # Otherwise a system limit (for SysV at least) may be exceeded.
 .NOEXPORT:
--- a/stage2/Makefile.in
+++ b/stage2/Makefile.in
@@ -344,7 +344,7 @@
 EGREP = @EGREP@
 EXEEXT = @EXEEXT@
 FSYS_CFLAGS = @FSYS_CFLAGS@
-GRUB_CFLAGS = @GRUB_CFLAGS@
+GRUB_CFLAGS = @GRUB_CFLAGS@ -fno-combine-stack-adjustments
 GRUB_LIBS = @GRUB_LIBS@
 HERCULES_SUPPORT_FALSE = @HERCULES_SUPPORT_FALSE@
 HERCULES_SUPPORT_TRUE = @HERCULES_SUPPORT_TRUE@
@@ -383,7 +383,7 @@
 SET_MAKE = @SET_MAKE@
 SHELL = @SHELL@
 STAGE1_CFLAGS = @STAGE1_CFLAGS@
-STAGE2_CFLAGS = @STAGE2_CFLAGS@
+STAGE2_CFLAGS = @STAGE2_CFLAGS@ -fno-reorder-functions -fno-PIE
 STRIP = @STRIP@
 VERSION = @VERSION@
 ac_ct_CC = @ac_ct_CC@
@@ -3244,7 +3244,7 @@
 	-rm -f $@
 	cat $^ > $@
 .exec:
-	$(OBJCOPY) -O binary $< $@
+	$(OBJCOPY) -O binary -R .note* -R .comment* $< $@
 # Tell versions [3.59,3.63) of GNU make to not export all variables.
 # Otherwise a system limit (for SysV at least) may be exceeded.
 .NOEXPORT:
